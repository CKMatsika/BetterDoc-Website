APP_NAME="BetterDoc DMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://[PLACEHOLDER-DOMAIN]

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZW

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=betterdoc
DB_USERNAME=betterdoc
DB_PASSWORD=
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=[PLACEHOLDER-SMTP-HOST]
MAIL_PORT=587
MAIL_USERNAME=[PLACEHOLDER-SMTP-USER]
MAIL_PASSWORD=[PLACEHOLDER-SMTP-PASSWORD]
MAIL_FROM_ADDRESS=hello@[PLACEHOLDER-DOMAIN].com
MAIL_FROM_NAME="BetterDoc DMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SITE_NAME="BetterDoc DMS"
SITE_TAGLINE="Document management that works when the internet doesn't."
SITE_DESCRIPTION="Secure, on-premises document management and workflow platform for organisations that cannot depend on the cloud."
SITE_EMAIL=clemence@betterlinkengineering.co.zw
SITE_PHONE="+263779613700"
SITE_WHATSAPP=https://wa.me/263779613700
SITE_ADDRESS="Stand 1225 Crowhill Views, Borrowdale, Harare, Zimbabwe"
SITE_COMPANY="Betterlink Industries Private Limited"
SITE_LINKEDIN=
SITE_TWITTER=
SITE_FACEBOOK=
SITE_LOGO=betterlink-logo.jpeg
SITE_PORTAL_URL=
SITE_SIGNUP_URL=

LEAD_NOTIFICATION_EMAIL=hello@[PLACEHOLDER-DOMAIN].com

ADMIN_EMAIL=admin@[PLACEHOLDER-DOMAIN].com
ADMIN_PASSWORD=
ADMIN_2FA_ENABLED=false
ADMIN_2FA_SECRET=

# Storage disk for any uploads (use s3 on Laravel Cloud)
UPLOADS_DISK=s3
